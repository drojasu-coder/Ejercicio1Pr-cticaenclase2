
# Puerto en el que correrá el servidor (opcional, por defecto 8081)
PORT=8081

# ---- Configuración de la base de datos PostgreSQL ----
# Host de la base de datos (ej: ep-xxx.us-east-2.aws.neon.tech)
DB_HOST=tu_host_aqui

# Usuario de la base de datos
DB_USER=tu_usuario_aqui

# Contraseña de la base de datos
DB_PASSWORD=tu_contrasena_aqui

# Nombre de la base de datos
DB_NAME=tu_nombre_bd_aqui

# Habilitar SSL: "true" para Neon/Render (en la nube), "false" para PostgreSQL local
DB_SSL=true
